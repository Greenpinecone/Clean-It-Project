# Editor configuration, see https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 2

[*.{ts,html,css,scss,json,yml,yaml}]
quote_type = single
ij_typescript_use_double_quotes = false
indent_size = 2

[*.md]
max_line_length = off
trim_trailing_whitespace = false

[*.{ts,html,css,scss,json,yml,yaml}]
indent_style = space
indent_size = 2